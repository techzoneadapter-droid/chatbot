# Gemini (dùng chung cho toàn bộ Page)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cần nếu muốn lưu Gemini API key mã hóa từ giao diện /ai
APP_ENCRYPTION_KEY=

# Database lưu Page, Page token và lịch sử chat
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook Messenger
FACEBOOK_VERIFY_TOKEN=change-this-to-a-random-secret
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# URL public đang deploy, ví dụ https://chatbot.example.com
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tùy chọn: khóa giao diện quản trị
ADMIN_ACCESS_TOKEN=
